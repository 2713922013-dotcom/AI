# ===== 大模型配置 =====
# 密钥（DeepSeek 或任意 OpenAI 兼容服务）。留空则系统运行在纯规则引擎模式
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# 兼容端点，默认 DeepSeek；换成百炼/智谱/Kimi 时同步改 LLM_MODEL
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 单次请求超时秒数
LLM_TIMEOUT=45
# 失败重试次数（0 表示不重试）
LLM_MAX_RETRIES=1
# 设为 0 可强制关闭大模型，走纯规则引擎
LLM_ENABLED=1

# ===== 数据存储 =====
DATABASE_URL=sqlite:///./offer_hunter.db
